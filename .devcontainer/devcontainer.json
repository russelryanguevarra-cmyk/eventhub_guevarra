{
  "name": "EventHub Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [5000, 4200],
  "portsAttributes": {
    "5000": {
      "label": "Flask Backend",
      "onAutoForward": "notify"
    },
    "4200": {
      "label": "Angular Frontend",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "pip install -r backend/requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "angular.ng-template",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}